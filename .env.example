# URL gốc của API, tính cả prefix /api/v1. Backend đã bật CORS nên gọi thẳng backend.
VITE_API_BASE_URL=https://tttn-five.vercel.app/api/v1

# OAuth Client ID dùng cho nút "Đăng nhập với Google" (Google Identity Services).
# Phải khớp với GOOGLE_CLIENT_ID phía backend.
VITE_GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
